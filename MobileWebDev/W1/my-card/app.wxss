/* app.wxss */
/* 全局样式 */

/* 页面基础样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  background-color: #f5f5f5;
}

/* 重置样式 */
view, text, image {
  box-sizing: border-box;
}

/* 文字不可选中（根据需求可调整） */
/* text {
  user-select: none;
} */

/* 图片默认行为 */
image {
  display: block;
}

/* 去除按钮默认边框 */
button::after {
  border: none;
}
